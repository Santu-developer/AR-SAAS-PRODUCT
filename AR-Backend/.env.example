# ============================================================
# AR Smart Menu — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values
# .env is gitignored — never commit real credentials
# ============================================================

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=armenu_db
DB_USERNAME=
DB_PASSWORD=

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ─────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=

# ── Cloudinary ──────────────────────────────────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay ────────────────────────────────────────────────
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
# Webhook secret — set when creating webhook in Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=
# Plan IDs created in Razorpay dashboard → Subscriptions → Plans
RAZORPAY_PLAN_STARTER=plan_
RAZORPAY_PLAN_GROWTH=plan_
RAZORPAY_PLAN_ENTERPRISE=plan_

# ── Email (Gmail SMTP App Password) ─────────────────────────
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Frontend URLs ───────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
AR_FRONTEND_URL=http://localhost:5174
